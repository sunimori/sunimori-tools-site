      step3: "<strong>Java Impact Analyzer</strong> anhaken → <strong>Next</strong> → Lizenz annehmen → <strong>Finish</strong>",
      step4: "Neu starten, wenn danach gefragt wird",
      eyebrowTrust: "Signatur", trustTitle: "Dem Zertifikat vertrauen (einmalig)",
      trustBody: "Die Installation fragt, ob Sie dem <strong>Zertifikat vertrauen</strong>. Vertrauen Sie ihm, wenn der Fingerprint mit dem unten übereinstimmt. Danach fragen Updates <strong>nie wieder</strong>.",
      fpChannel: "Holen Sie sich diesen Fingerprint <strong>auch über einen zweiten Kanal</strong> — von der Person, die das Werkzeug pflegt. Diese Seite und der Download liegen am selben Ort; nur hier zu prüfen belegt wenig.",
      trustNote: "<strong>Erscheint nach diesem ersten Mal wieder eine Zertifikatsabfrage, brechen Sie ab.</strong> Ein legitimes Update fragt nicht erneut. Eine Abfrage heißt: das Ausgelieferte wurde mit einem anderen Schlüssel signiert — oder gar nicht.",
      eyebrowHarden: "Härtung", hardenTitle: "Unsignierte Inhalte ablehnen (empfohlen)",
      hardenBody: "Diese Zeile in <code class=\"i\">eclipse.ini</code> lässt unsignierte Inhalte <strong>fehlschlagen</strong> statt nur zu warnen. Man kann nicht darüber hinweg klicken, also lässt sich ein ausgetauschtes Artefakt nicht unbemerkt installieren.",
      eyebrowUpdate: "Updates", updateTitle: "So wird aktualisiert",
      updateBody: "<strong>Help → Check for Updates</strong>. Kein Austauschen von jars, und keine Dateien, die ein laufendes Eclipse blockiert.",
      reqTitle: "Voraussetzungen", reqBody: "Eclipse 4.27 (2023-03) oder neuer, JDK 17 oder neuer. Englisch, Japanisch und Chinesisch, in den Einstellungen umschaltbar.",
      offlineTitle: "Offline installieren",
      offlineBody: "Für einen Rechner ohne Zugang zu dieser Seite das <a href=\"impact-analyzer.zip\">Zip der Update-Site</a> weitergeben und in Eclipse <strong>Add → Archive…</strong> benutzen. Entpacken ist nicht nötig.",
      supportTitle: "Kontakt",
      supportBody: "Probleme und Wünsche an <a href='mailto:support@sunimori.tools'>support@sunimori.tools</a>. Bitte die <strong>oben angezeigte Version und die betreffenden Zeilen aus dem Fehlerprotokoll</strong> mitschicken - ohne die lässt sich von hier aus nichts nachvollziehen."
    }
  };

  var TICK = '<svg class="tick" viewBox="0 0 24 24" fill="none" stroke="currentColor"'
           + ' stroke-width="3" stroke-linecap="round" stroke-linejoin="round">'
           + '<path d="M5 13l4 4L19 7"/></svg>';

  var btn = document.getElementById("langBtn");
  var menu = document.getElementById("langMenu");
  var now = document.getElementById("langNow");
  var current = "ja";

  LANGS.forEach(function (l) {
    var b = document.createElement("button");
    b.type = "button";
    b.setAttribute("role", "menuitemradio");
    b.dataset.lang = l.id;
    b.innerHTML = TICK + '<span>' + l.name + '</span><span class="sub">' + l.tag + '</span>';
    b.addEventListener("click", function () { pick(l.id); close(); btn.focus(); });
    menu.appendChild(b);
  });

  function apply(lang) {
    var t = T[lang] || T.en;
    document.documentElement.lang = lang;
    document.querySelectorAll("[data-i18n]").forEach(function (el) {
      var v = t[el.getAttribute("data-i18n")];
      if (v != null) { el.innerHTML = v; }
    });
    var meta = LANGS.filter(function (l) { return l.id === lang; })[0];
    now.textContent = meta ? meta.name : lang;
    menu.querySelectorAll("button").forEach(function (b) {
      b.setAttribute("aria-checked", String(b.dataset.lang === lang));
    });
  }

  function pick(lang) {
    current = lang;
    apply(lang);
    try { localStorage.setItem("st.lang", lang); } catch (e) { /* 保存できなくても使える */ }
  }

  function open() { menu.classList.add("open"); btn.setAttribute("aria-expanded", "true"); }
  function close() { menu.classList.remove("open"); btn.setAttribute("aria-expanded", "false"); }

  btn.addEventListener("click", function (e) {
    e.stopPropagation();
    if (menu.classList.contains("open")) { close(); } else { open(); }
  });
  document.addEventListener("click", function (e) {
    if (!menu.contains(e.target) && !btn.contains(e.target)) { close(); }
  });
  document.addEventListener("keydown", function (e) {
    if (e.key === "Escape") { close(); }
  });

  // 起動時の言語: 前回の選択 → 閲覧環境の設定 → 日本語
  var saved = null;
  try { saved = localStorage.getItem("st.lang"); } catch (e) { /* 同上 */ }
  if (!saved) {
    var nav = (navigator.languages || [navigator.language || "ja"]).join(",").toLowerCase();
    var hit = LANGS.filter(function (l) { return nav.indexOf(l.id) >= 0; })[0];
    saved = hit ? hit.id : "ja";
  }
  pick(saved);

  // 帯は、少しでも巻いたら下辺の線を出す。常に出しておくと、
  // 一番上に居る時に画面を無意味に二分してしまう
  var topbar = document.getElementById("topbar");
  var onScroll = function () { topbar.classList.toggle("stuck", window.scrollY > 4); };
  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  // ---- 写す釦 ----
  document.querySelectorAll("[data-copy]").forEach(function (b) {
    b.addEventListener("click", function () {
      var src = document.getElementById(b.getAttribute("data-copy"));
      var text = src.textContent.replace(/\s*\n\s*/g, " ").trim();
      var label = b.querySelector("[data-i18n]");
      var back = label ? label.innerHTML : "";
      var done = function () {
        b.classList.add("done");
        if (label) { label.innerHTML = (T[current] || T.en).copied; }
        setTimeout(function () {
          b.classList.remove("done");
          if (label) { label.innerHTML = back; }
        }, 1400);
      };
      if (navigator.clipboard) {
        navigator.clipboard.writeText(text).then(done, done);
      } else {
        // 古い環境。選んだ状態にして手で写せるようにするだけでも意味がある
        var r = document.createRange();
        r.selectNodeContents(src);
        var s = window.getSelection();
        s.removeAllRanges();
        s.addRange(r);
        done();
      }
    });
  });
})();
</script>